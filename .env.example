# Copy to .env and customize:
#   cp .env.example .env
#   copy .env.example .env
#
# Docker Compose reads .env automatically for ${VAR} substitution.
# Local `dotnet run` also loads this file from the repo root (existing env wins).
# Run ./setup.sh or .\setup.ps1 to create .env (if missing) and the shared network.

# External Docker network shared with other workspace services (e.g. reverse proxy, Ollama).
# Create once via setup, or: docker network create <name>
DOCKER_SHARED_NETWORK=workspace

# LLM enrichment (Ollama or OpenAI)
# Provider: Ollama | OpenAI
LLM_PROVIDER=Ollama
# Docker (Ollama on shared network): http://ollama:11434
# Local dotnet run / Ollama on host: http://localhost:11434
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2
# Required when LLM_PROVIDER=OpenAI
LLM_API_KEY=
