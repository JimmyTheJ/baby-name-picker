# Copy to .env and customize:
#   cp .env.example .env
#   copy .env.example .env
#
# Docker Compose reads .env automatically for ${VAR} substitution.
# Run ./setup.sh or .\setup.ps1 to create .env (if missing) and the shared network.

# External Docker network shared with other workspace services (e.g. reverse proxy, Ollama).
# Create once via setup, or: docker network create <name>
DOCKER_SHARED_NETWORK=workspace
